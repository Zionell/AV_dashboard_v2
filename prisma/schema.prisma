// `prisma-client` вместо legacy `prisma-client-js`: тот копировал к себе CJS-рантайм с
// `__dirname`, который Nitro инлайнил в ESM-бандл — прод падал с «__dirname is not
// defined». Новый генератор импортирует `@prisma/client/runtime/library`, и в ESM-сборке
// рантайма (`library.mjs`) `__dirname` объявлен самой Prisma.
// importFileExtension = "ts": по умолчанию генератор пишет внутри себя импорты вида
// `./enums.js`, которых на диске нет (файлы .ts). Vite это переживает, а голый node
// в скриптах (`node --experimental-transform-types scripts/*.ts`) падает с
// ERR_MODULE_NOT_FOUND. С «ts» пути совпадают с реальными файлами для обоих.
generator client {
    provider            = "prisma-client"
    output              = "./generated/prisma"
    runtime             = "nodejs"
    moduleFormat        = "esm"
    importFileExtension = "ts"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    email       String  @unique
    image       String?
    bio         String?
    hash        String?
    hasPassword Boolean @default(false)
    phone       String?
    role        String  @default("EMPLOYEE")

    // Норма рабочего дня в часах — у каждого своя (задаётся при приглашении).
    // Относительно неё считается переработка в times/stats и times/team.
    workHours Int @default(8)

    times           Times[]
    executor        Todo[]
    authoredTodos   Todo[]           @relation("TodoAuthor")
    projects        UsersOnProjects[]
    materials       Material[]
    todoComments    TodoComment[]
    todoAttachments TodoAttachment[]
    events          Event[]

    companyId String?  @db.ObjectId
    company   Company? @relation(fields: [companyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Times {
    id     String  @id @default(auto()) @map("_id") @db.ObjectId
    userId String  @db.ObjectId
    active Boolean @default(false)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    todoId String? @db.ObjectId
    todo   Todo?   @relation(fields: [todoId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Company {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String

    // Тариф: FREE | PRO | TEAM. Лимиты мест и хранилища — в COMPANY_PLANS
    // (shared/types/company.ts), в БД держим только сам план.
    plan String @default("FREE")

    users              User[]
    materials          Material[]
    materialCategories MaterialCategory[]
    projects           Project[]
    attachments        TodoAttachment[]
    invitations        Invitation[]
}

// Приглашение в компанию. Живёт до принятия или истечения — без него приглашённому
// негде взять компанию и заданную пригласившим норму часов.
model Invitation {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    email String
    // Секрет из ссылки в письме. Уникален, чтобы принять приглашение можно было один раз.
    token String @unique

    // Норма рабочего дня, которую пригласивший задаёт приглашённому.
    // При принятии копируется в User.workHours.
    workHours Int @default(8)

    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    invitedById String? @db.ObjectId

    expiresAt  DateTime
    acceptedAt DateTime?

    createdAt DateTime @default(now())

    @@index([companyId])
    @@index([email])
}

model Project {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    image       String?
    description String?

    client String?
    // Числом, как и у задач: 3=HIGH, 2=MEDIUM, 1=LOW; null — без приоритета.
    priority  Int?
    startDate DateTime?
    deadline  DateTime?
    budget    Int?

    links ProjectLink[]

    materials Material[]

    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    users  UsersOnProjects[]
    todo   Todo[]
    events Event[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// Лента активности проекта.
model Event {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    type String

    projectId String  @db.ObjectId
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    actorId String? @db.ObjectId
    actor   User?   @relation(fields: [actorId], references: [id])

    // Имя задачи/материала на момент события — объект может быть удалён позже.
    targetName String?
    // Доп. данные, напр. { from: 'TODO', to: 'DONE' }
    meta       Json?

    createdAt DateTime @default(now())
}

type ProjectLink {
    name String
    url  String
}

model UsersOnProjects {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])
    userId String @db.ObjectId

    isCurrent Boolean @default(false)

    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId String  @db.ObjectId
}

model Todo {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String?
    isCompleted Boolean @default(false)

    projectId String   @db.ObjectId
    project   Project? @relation(fields: [projectId], references: [id])

    executorId String @db.ObjectId
    executor   User   @relation(fields: [executorId], references: [id])

    authorId String? @db.ObjectId
    author   User?   @relation("TodoAuthor", fields: [authorId], references: [id])

    status String @default("TODO")
    // Числом, чтобы БД могла сортировать: 3=HIGH, 2=MEDIUM, 1=LOW; null — без приоритета.
    // При сортировке desc null'ы уходят вниз (в BSON null < любого числа).
    priority      Int?
    dueDate       DateTime?
    estimateHours Int?

    times       Times[]
    comments    TodoComment[]
    attachments TodoAttachment[]

    @@index([projectId, priority])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TodoComment {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    text String

    todoId String @db.ObjectId
    todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

    authorId String @db.ObjectId
    author   User   @relation(fields: [authorId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TodoAttachment {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    data String
    // Размер декодированного файла в байтах — чтобы считать занятое место
    // одним _sum, не читая сами base64-строки.
    size Int

    todoId String @db.ObjectId
    todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

    authorId String @db.ObjectId
    author   User   @relation(fields: [authorId], references: [id])

    // Денормализация: в Mongo нет джойнов, и без прямого companyId подсчёт квоты
    // компании превращается в обход attachment → todo → project.
    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    @@index([companyId])

    createdAt DateTime @default(now())
}

model Material {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String?
    sourceLink  String

    categoryId String           @db.ObjectId
    category   MaterialCategory @relation(fields: [categoryId], references: [id])

    authorId String? @db.ObjectId
    author   User?   @relation(fields: [authorId], references: [id])

    companyId String   @db.ObjectId
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
	project   Project? @relation(fields: [projectId], references: [id])
    projectId String?  @db.ObjectId

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model MaterialCategory {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    label String
    color String

    // Справочник у каждой компании свой: без этого поля категории всех компаний
    // видны всем и засоряются чужими.
    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    material Material[]

    @@index([companyId])
}
