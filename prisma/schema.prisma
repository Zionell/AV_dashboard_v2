generator client {
    provider            = "prisma-client"
    output              = "../app/generated/prisma"
    runtime             = "nodejs"
    moduleFormat        = "esm"
    importFileExtension = "ts"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    email       String  @unique
    image       String?
    bio         String?
    hash        String?
    hasPassword Boolean @default(false)
    phone       String?
    role        String  @default("EMPLOYEE")

    workHours Int @default(8)

    times           Times[]
    executor        Todo[]
    authoredTodos   Todo[]            @relation("TodoAuthor")
    projects        UsersOnProjects[]
    materials       Material[]
    todoComments    TodoComment[]
    todoAttachments TodoAttachment[]
    events          Event[]

    companyId String?  @db.ObjectId
    company   Company? @relation(fields: [companyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Times {
    id     String  @id @default(auto()) @map("_id") @db.ObjectId
    userId String  @db.ObjectId
    active Boolean @default(false)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    todoId String? @db.ObjectId
    todo   Todo?   @relation(fields: [todoId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Company {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String

    plan String @default("FREE")

    users              User[]
    materials          Material[]
    materialCategories MaterialCategory[]
    projects           Project[]
    attachments        TodoAttachment[]
    invitations        Invitation[]
}

model Invitation {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    email String
    token String @unique

    workHours Int @default(8)

    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    invitedById String? @db.ObjectId

    expiresAt  DateTime
    acceptedAt DateTime?

    createdAt DateTime @default(now())

    @@index([companyId])
    @@index([email])
}

model Project {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    image       String?
    description String?

    client    String?
    priority  Int?
    startDate DateTime?
    deadline  DateTime?
    budget    Int?

    links ProjectLink[]

    materials Material[]

    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    users  UsersOnProjects[]
    todo   Todo[]
    events Event[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Event {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    type String

    projectId String  @db.ObjectId
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    actorId String? @db.ObjectId
    actor   User?   @relation(fields: [actorId], references: [id])

    targetName String?
    meta       Json?

    createdAt DateTime @default(now())
}

type ProjectLink {
    name String
    url  String
}

model UsersOnProjects {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])
    userId String @db.ObjectId

    isCurrent Boolean @default(false)

    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId String  @db.ObjectId
}

model Todo {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String?
    isCompleted Boolean @default(false)

    projectId String   @db.ObjectId
    project   Project? @relation(fields: [projectId], references: [id])

    executorId String @db.ObjectId
    executor   User   @relation(fields: [executorId], references: [id])

    authorId String? @db.ObjectId
    author   User?   @relation("TodoAuthor", fields: [authorId], references: [id])

    status        String    @default("TODO")
    priority      Int?
    dueDate       DateTime?
    estimateHours Int?

    times       Times[]
    comments    TodoComment[]
    attachments TodoAttachment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([projectId, priority])
}

model TodoComment {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    text String

    todoId String @db.ObjectId
    todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

    authorId String @db.ObjectId
    author   User   @relation(fields: [authorId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TodoAttachment {
    id   String @id @default(auto()) @map("_id") @db.ObjectId
    name String
    data String
    size Int

    todoId String @db.ObjectId
    todo   Todo   @relation(fields: [todoId], references: [id], onDelete: Cascade)

    authorId String @db.ObjectId
    author   User   @relation(fields: [authorId], references: [id])

    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@index([companyId])
}

model Material {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    description String?
    sourceLink  String

    categoryId String           @db.ObjectId
    category   MaterialCategory @relation(fields: [categoryId], references: [id])

    authorId String? @db.ObjectId
    author   User?   @relation(fields: [authorId], references: [id])

    companyId String   @db.ObjectId
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    project   Project? @relation(fields: [projectId], references: [id])
    projectId String?  @db.ObjectId

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model MaterialCategory {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    label String
    color String

    companyId String  @db.ObjectId
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    material Material[]

    @@index([companyId])
}
