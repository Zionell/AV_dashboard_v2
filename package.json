{
    "name": "av_dashboard",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "start": "nuxt start",
        "dev": "nuxt dev",
        "postinstall": "nuxt prepare",
        "prettier": "npx prettier . --write",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "test:api": "npm run db:seed-test && vitest run --project api",
        "test:all": "npm run db:seed-test && vitest run",
        "db:push-test": "DOTENV_CONFIG_PATH=.env.test prisma db push",
        "db:seed-test": "node --experimental-transform-types scripts/seed-test-db.ts",
        "db:seed-demo": "node --experimental-transform-types scripts/seed-demo.ts",
        "db-push": "prisma db push",
        "db-pull": "prisma db pull",
        "prisma-studio": "prisma studio",
        "prisma:generate": "prisma generate",
        "update": "ncu -u",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,vue,mjs,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.116",
        "@nuxt/ui": "^4.9.0",
        "@nuxtjs/robots": "^6.1.2",
        "@nuxtjs/sitemap": "^8.2.2",
        "@pinia/nuxt": "^0.11.3",
        "@prisma/client": "6.19",
        "@tiptap/vue-3": "^3.27.1",
        "@vueuse/core": "^14.3.0",
        "@vueuse/nuxt": "^14.3.0",
        "bcryptjs": "^3.0.3",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "nodemailer": "^9.0.3",
        "npm-check-updates": "^22.2.9",
        "nuxt": "^4.4.8",
        "nuxt-auth-utils": "^0.5.29",
        "nuxt-csurf": "^1.6.5",
        "nuxt-security": "^2.6.0",
        "pinia": "^3.0.4",
        "tiptap-extension-code-block-shiki": "^1.2.0",
        "vue": "^3.5.39",
        "vue-router": "^5.1.0",
        "vuedraggable": "^4.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@nuxt/devtools": "^3.2.4",
        "@nuxt/eslint": "^1.16.0",
        "@nuxt/image": "^2.0.0",
        "@nuxt/test-utils": "^4.0.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^26.1.0",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "prettier": "^3.9.4",
        "prisma": "6.19",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.6"
    }
}
