# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=
SITE_URL=http://localhost:3000
DATABASE_URL=

# Session encryption key, 32+ chars
NUXT_SESSION_PASSWORD=

# Google OAuth (redirect URI must be whitelisted in Google Cloud Console)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# SMTP для nodemailer (пока не используется: отправка замокана в server/utils/mailer.ts)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="AV Dashboard <no-reply@example.com>"
